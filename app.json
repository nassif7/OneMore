{
  "expo": {
    "name": "OneMore",
    "slug": "OneMore",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onemore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pro.nassif.onemore",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pro.nassif.onemore",
      "adaptiveIcon": {
        "backgroundColor": "#B43A2D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#B43A2D",
          "resizeMode": "cover"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-image",
      "./plugins/withPodDeploymentTargetFix.js",
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.4" } }],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.pro.nassif.onemore",
          "widgets": [
            {
              "name": "OneMoreWidget",
              "displayName": "OneMore",
              "description": "Today's count and time since your last one.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryCircular", "accessoryRectangular"],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab683ba2-0c69-4f4c-95a0-2414daa9fcca"
      }
    },
    "owner": "nassif.pro"
  }
}
